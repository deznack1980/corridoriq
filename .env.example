# CorridorIQ server environment - VARIABLE NAMES ONLY. Never commit values.
# CorridorIQ does not read this file; set these as real environment variables
# for the server process (e.g. in the scheduled task / service environment).

# --- core ---------------------------------------------------------------
CORRIDORIQ_ENV=
CORRIDORIQ_HOST=
CORRIDORIQ_PORT=
CORRIDORIQ_DB_PATH=

# --- supplier billing (Stripe) -----------------------------------------
# Feature switch. Anything other than 1 = billing routes and page return 404.
CORRIDORIQ_BILLING_ENABLED=
# Origin used to build Checkout success/cancel and Portal return URLs.
# https only (http allowed for 127.0.0.1/localhost in development).
CORRIDORIQ_PUBLIC_BASE_URL=
# sk_test_/rk_test_ in development; sk_live_/rk_live_ only with CORRIDORIQ_ENV=production.
STRIPE_SECRET_KEY=
# Optional (Checkout is Stripe-hosted); validated to match the secret key's mode.
STRIPE_PUBLISHABLE_KEY=
# whsec_... signing secret of the webhook endpoint for THIS environment.
STRIPE_WEBHOOK_SECRET=
# Production: price_1UN6Fd4RtdKUQkwzqRlc3bPc. Test mode needs its own test price.
STRIPE_FOUNDING_SUPPLY_PRICE_ID=
# Optional cross-check used by `python -m pipeline.billing verify-price`.
STRIPE_FOUNDING_SUPPLY_PRICE_LOOKUP_KEY=
# Contractor Pro ($99/month, contractor organizations). Optional until configured;
# must differ from the Founding Supply Partner price. Test mode needs a test price.
STRIPE_CONTRACTOR_PRO_PRICE_ID=
STRIPE_CONTRACTOR_PRO_PRICE_LOOKUP_KEY=
