# CEO model configuration. Leave narration off for the deterministic v0.1 engine.
# Do not put a real key in source control. Export CEO_MODEL_API_KEY in the shell.
CEO_MODEL_PROVIDER=none
CEO_MODEL_NAME=
CEO_ENABLE_MODEL_NARRATION=0
CEO_MAX_MODEL_CALLS=2
CEO_MAX_CONTEXT_CHARS=12000
CEO_RETRIEVAL_LIMIT=8
CEO_CHUNK_CHARS=1200
